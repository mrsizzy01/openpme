datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  ORG_OWNER
  MANAGER
  ACCOUNTANT
  CASHIER
  SALES_REP
  INVENTORY_MANAGER
  PURCHASER
  AUDITOR
}

enum Currency {
  CDF
  USD
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum InvoiceType {
  STANDARD
  PROFORMA
  ADVANCE
  CREDIT_NOTE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  MOBILE_MONEY_MPESA
  MOBILE_MONEY_AIRTEL
  MOBILE_MONEY_ORANGE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum StockMovementType {
  IN_PURCHASE
  IN_RETURN
  IN_ADJUSTMENT
  OUT_SALE
  OUT_RETURN
  OUT_LOSS
  OUT_ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  IN
  OUT
}

enum DesktopTerminalStatus {
  ACTIVE
  LOCKED
}

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AnomalyStatus {
  DETECTED
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum AnomalyRuleType {
  DUPLICATE_INVOICE
  DUPLICATE_PAYMENT
  HIGH_DISCOUNT
  CASH_DISCREPANCY
  ABNORMAL_EXPENSE
  NEGATIVE_STOCK
  UNJUSTIFIED_PAYMENT
  UNUSUAL_CANCEL
  EXCESSIVE_TRANSACTION
}

enum SaleStatus {
  COMPLETED
  PENDING
  CANCELLED
}

enum PurchaseStatus {
  ORDERED
  RECEIVED
  PARTIALLY_RECEIVED
  CANCELLED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  legalName String?
  taxId     String? // NIF
  rccm      String? // RCCM
  idNat     String? // ID NAT
  email     String?
  phone     String?
  address   String?
  city      String?
  country   String   @default("RDC")
  logoUrl   String?
  sector    String?  @default("Commerce Général")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings          OrganizationSettings?
  users             User[]
  categories        Category[]
  warehouses        Warehouse[]
  products          Product[]
  customers         Customer[]
  suppliers         Supplier[]
  sales             Sale[]
  purchases         Purchase[]
  stockMovements    StockMovement[]
  invoices          Invoice[]
  payments          Payment[]
  expenses          Expense[]
  cashRegisters     CashRegister[]
  cashSessions      CashSession[]
  cashMovements     CashMovement[]
  financialAccounts FinancialAccount[]
  anomalyAlerts     AnomalyAlert[]
  auditLogs         AuditLog[]
  exchangeRates     ExchangeRate[]
  desktopTerminals  DesktopTerminal[]

  @@map("organizations")
}

model OrganizationSettings {
  id                            String       @id @default(uuid())
  organizationId                String       @unique
  organization                  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  primaryCurrency               Currency     @default(CDF)
  secondaryCurrency             Currency     @default(USD)
  exchangeRateUsdToCdf          Decimal      @default(2850.00) @db.Decimal(12, 4)
  taxRatePercent                Decimal      @default(16.00) @db.Decimal(5, 2)
  enableTax                     Boolean      @default(true)
  invoicePrefix                 String       @default("FAC-")
  quotePrefix                   String       @default("DEV-")
  receiptPrefix                 String       @default("REC-")
  invoiceNextNumber             Int          @default(1001)
  quoteNextNumber               Int          @default(1001)
  paymentTermsDays              Int          @default(30)
  invoiceFooterNote             String?      @default("Merci de votre confiance.")
  bankDetails                   String?
  mobileMoneyDetails            String?
  alertMaxDiscountPercent       Decimal      @default(15.00) @db.Decimal(5, 2)
  alertLargeExpenseThreshold    Decimal      @default(1000000.00) @db.Decimal(15, 2)
  alertCashDiscrepancyThreshold Decimal      @default(10000.00) @db.Decimal(15, 2)
  primaryColor                  String       @default("#1E40AF")
  themeMode                     String       @default("light")
  createdAt                     DateTime     @default(now())
  updatedAt                     DateTime     @updatedAt

  @@map("organization_settings")
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           UserRole     @default(CASHIER)
  phone          String?
  avatarUrl      String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sales           Sale[]
  purchases       Purchase[]
  stockMovements  StockMovement[]
  payments        Payment[]
  expenses        Expense[]
  cashSessions    CashSession[]
  auditLogs       AuditLog[]
  sessions        Session[]
  lockedTerminals DesktopTerminal[] @relation("DesktopTerminalLocker")

  @@index([organizationId])
  @@index([email])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  terminalId   String?
  token        String   @unique
  refreshToken String?  @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  lastSeenAt   DateTime @default(now())
  revoked      Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId, revoked, expiresAt])
  @@index([lastSeenAt])
  @@map("sessions")
}

model DesktopTerminal {
  id                  String                @id @default(uuid())
  terminalId          String
  organizationId      String
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  displayName         String
  status              DesktopTerminalStatus @default(ACTIVE)
  tokenHash           String?               @unique
  tokenRevokedAt      DateTime?
  lockReason          String?
  lockedAt            DateTime?
  lockedById          String?
  lockedBy            User?                 @relation("DesktopTerminalLocker", fields: [lockedById], references: [id], onDelete: SetNull)
  lastHeartbeatAt     DateTime?
  lastIpAddress       String?
  stateVersion        Int                   @default(1)
  acknowledgedVersion Int                   @default(0)
  lastAcknowledgedAt  DateTime?
  offlineGraceHours   Int                   @default(24)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([organizationId, terminalId])
  @@index([organizationId, status])
  @@index([organizationId, lastHeartbeatAt])
  @@map("desktop_terminals")
}

model Category {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  products Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("categories")
}

model Warehouse {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  location       String?
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  warehouseStocks WarehouseStock[]
  stockMovements  StockMovement[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("warehouses")
}

model Product {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  code           String
  barcode        String?
  name           String
  description    String?
  purchasePrice  Decimal      @default(0.00) @db.Decimal(15, 2)
  salePrice      Decimal      @default(0.00) @db.Decimal(15, 2)
  currency       Currency     @default(CDF)
  minStockLevel  Int          @default(5)
  currentStock   Int          @default(0)
  unit           String       @default("Pièce")
  isService      Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  warehouseStocks WarehouseStock[]
  saleItems       SaleItem[]
  purchaseItems   PurchaseItem[]
  invoiceItems    InvoiceItem[]
  stockMovements  StockMovement[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([categoryId])
  @@map("products")
}

model WarehouseStock {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, productId])
  @@map("warehouse_stocks")
}

model Customer {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code               String
  name               String
  companyName        String?
  email              String?
  phone              String?
  address            String?
  creditLimit        Decimal      @default(0.00) @db.Decimal(15, 2)
  outstandingBalance Decimal      @default(0.00) @db.Decimal(15, 2)
  currency           Currency     @default(CDF)
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  sales    Sale[]
  invoices Invoice[]
  payments Payment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("customers")
}

model Supplier {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code            String
  name            String
  contactPerson   String?
  email           String?
  phone           String?
  address         String?
  outstandingDebt Decimal      @default(0.00) @db.Decimal(15, 2)
  currency        Currency     @default(CDF)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  purchases Purchase[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("suppliers")
}

model Sale {
  id                   String       @id @default(uuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  saleNumber           String
  idempotencyKey       String?
  customerId           String?
  customer             Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  userId               String
  user                 User         @relation(fields: [userId], references: [id])
  subtotal             Decimal      @db.Decimal(15, 2)
  discountAmount       Decimal      @default(0.00) @db.Decimal(15, 2)
  taxAmount            Decimal      @default(0.00) @db.Decimal(15, 2)
  total                Decimal      @db.Decimal(15, 2)
  currency             Currency     @default(CDF)
  exchangeRateUsdToCdf Decimal      @default(2850.00) @db.Decimal(12, 4)
  changeAmountCdf      Decimal      @default(0.00) @db.Decimal(15, 2)
  status               SaleStatus   @default(COMPLETED)
  notes                String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  items   SaleItem[]
  invoice Invoice?

  @@unique([organizationId, saleNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([customerId])
  @@index([userId])
  @@map("sales")
}

model SaleItem {
  id              String  @id @default(uuid())
  saleId          String
  sale            Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  quantity        Int
  unitPrice       Decimal @db.Decimal(15, 2)
  unitCost        Decimal? @db.Decimal(15, 2)
  discountPercent Decimal @default(0.00) @db.Decimal(5, 2)
  taxRatePercent  Decimal @default(0.00) @db.Decimal(5, 2)
  total           Decimal @db.Decimal(15, 2)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Purchase {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseNumber String
  supplierId     String
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  subtotal       Decimal        @db.Decimal(15, 2)
  taxAmount      Decimal        @default(0.00) @db.Decimal(15, 2)
  total          Decimal        @db.Decimal(15, 2)
  currency       Currency       @default(CDF)
  status         PurchaseStatus @default(RECEIVED)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items PurchaseItem[]

  @@unique([organizationId, purchaseNumber])
  @@index([organizationId])
  @@index([supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Decimal  @db.Decimal(15, 2)
  total      Decimal  @db.Decimal(15, 2)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model StockMovement {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  idempotencyKey String?
  warehouseId    String
  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id])
  productId      String
  product        Product           @relation(fields: [productId], references: [id])
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  type           StockMovementType
  quantity       Int
  previousStock  Int
  newStock       Int
  reference      String?
  reason         String?
  createdAt      DateTime          @default(now())

  @@index([organizationId])
  @@unique([organizationId, idempotencyKey])
  @@index([productId])
  @@index([warehouseId])
  @@map("stock_movements")
}

model Invoice {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceNumber  String
  type           InvoiceType   @default(STANDARD)
  status         InvoiceStatus @default(ISSUED)
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  saleId         String?       @unique
  sale           Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  subtotal       Decimal       @db.Decimal(15, 2)
  discountAmount Decimal       @default(0.00) @db.Decimal(15, 2)
  taxAmount      Decimal       @default(0.00) @db.Decimal(15, 2)
  total          Decimal       @db.Decimal(15, 2)
  paidAmount     Decimal       @default(0.00) @db.Decimal(15, 2)
  balance        Decimal       @db.Decimal(15, 2)
  currency       Currency      @default(CDF)
  notes          String?
  terms          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id              String   @id @default(uuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description     String
  quantity        Int
  unitPrice       Decimal  @db.Decimal(15, 2)
  discountPercent Decimal  @default(0.00) @db.Decimal(5, 2)
  taxRatePercent  Decimal  @default(0.00) @db.Decimal(5, 2)
  total           Decimal  @db.Decimal(15, 2)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id                   String        @id @default(uuid())
  organizationId       String
  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentNumber        String
  idempotencyKey       String?
  invoiceId            String?
  invoice              Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customerId           String?
  customer             Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cashSessionId        String?
  cashSession          CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  userId               String
  user                 User          @relation(fields: [userId], references: [id])
  amount               Decimal       @db.Decimal(15, 2)
  currency             Currency      @default(CDF)
  method               PaymentMethod @default(CASH)
  reference            String?
  status               PaymentStatus @default(COMPLETED)
  exchangeRateUsdToCdf Decimal       @default(2850.00) @db.Decimal(12, 4)
  appliedAmount        Decimal?      @db.Decimal(15, 2)
  notes                String?
  createdAt            DateTime      @default(now())

  @@unique([organizationId, paymentNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([invoiceId])
  @@index([customerId])
  @@map("payments")
}

model CashRegister {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  location       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sessions CashSession[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("cash_registers")
}

model CashSession {
  id                 String            @id @default(uuid())
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cashRegisterId     String
  cashRegister       CashRegister      @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  userId             String
  user               User              @relation(fields: [userId], references: [id])
  openingBalance     Decimal           @default(0.00) @db.Decimal(15, 2)
  closingBalance     Decimal?          @db.Decimal(15, 2)
  theoreticalBalance Decimal?          @db.Decimal(15, 2)
  difference         Decimal?          @db.Decimal(15, 2)
  currency           Currency          @default(CDF)
  status             CashSessionStatus @default(OPEN)
  openedAt           DateTime          @default(now())
  closedAt           DateTime?
  notes              String?

  payments  Payment[]
  movements CashMovement[]

  @@index([organizationId])
  @@index([cashRegisterId])
  @@index([userId])
  @@map("cash_sessions")
}

model CashMovement {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cashSessionId  String
  cashSession    CashSession      @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  type           CashMovementType
  amount         Decimal          @db.Decimal(15, 2)
  reference      String?
  description    String
  createdAt      DateTime         @default(now())

  @@index([organizationId])
  @@index([cashSessionId, createdAt])
  @@map("cash_movements")
}

model FinancialAccount {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  type           String       @default("BANK") // BANK, CASH, MOBILE_MONEY
  accountNumber  String?
  bankName       String?
  balance        Decimal      @default(0.00) @db.Decimal(15, 2)
  currency       Currency     @default(CDF)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  expenses Expense[]

  @@index([organizationId])
  @@map("financial_accounts")
}

model Expense {
  id                   String            @id @default(uuid())
  organizationId       String
  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenseNumber        String
  idempotencyKey       String?
  category             String
  amount               Decimal           @db.Decimal(15, 2)
  currency             Currency          @default(CDF)
  exchangeRateUsdToCdf Decimal           @default(2850.00) @db.Decimal(12, 4)
  beneficiary          String
  method               PaymentMethod     @default(CASH)
  reference            String?
  notes                String?
  date                 DateTime          @default(now())
  userId               String
  user                 User              @relation(fields: [userId], references: [id])
  financialAccountId   String?
  financialAccount     FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: SetNull)
  createdAt            DateTime          @default(now())

  @@unique([organizationId, expenseNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([userId])
  @@map("expenses")
}

model AnomalyAlert {
  id                String          @id @default(uuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ruleType          AnomalyRuleType
  severity          AnomalySeverity @default(MEDIUM)
  status            AnomalyStatus   @default(DETECTED)
  title             String
  explanation       String
  entityType        String
  entityId          String
  observedValue     String?
  expectedThreshold String?
  resolvedAt        DateTime?
  resolutionNote    String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([ruleType])
  @@map("anomaly_alerts")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  entity         String
  entityId       String
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([entity])
  @@map("audit_logs")
}

model ExchangeRate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromCurrency   Currency
  toCurrency     Currency
  rate           Decimal      @db.Decimal(12, 4)
  source         String       @default("Banque Centrale du Congo / Marché")
  effectiveDate  DateTime     @default(now()) @db.Date
  createdAt      DateTime     @default(now())

  @@unique([organizationId, fromCurrency, toCurrency, effectiveDate])
  @@index([organizationId])
  @@map("exchange_rates")
}
