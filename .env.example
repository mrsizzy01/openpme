# Copy this file to .env and replace every placeholder before starting the API.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/smart_pme_finance?schema=public"

# Generate a random secret with at least 32 characters. Required in production.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PORT=3001
NODE_ENV=development

# Compose database settings. Use a URL-safe random password.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=smart_pme_finance

# Optional local-only demo credentials. If omitted, the seed generates random passwords.
# DEMO_OWNER_PASSWORD=
# DEMO_MANAGER_PASSWORD=
# DEMO_ACCOUNTANT_PASSWORD=
# DEMO_CASHIER_PASSWORD=

DEFAULT_CURRENCY=CDF
SECONDARY_CURRENCY=USD
DEFAULT_EXCHANGE_RATE_USD_TO_CDF=2850.00

# Required to enroll desktop terminals. Generate a separate random value for each environment.
DESKTOP_ENROLLMENT_SECRET=replace-with-a-random-enrollment-secret
