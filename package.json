{
  "name": "smart-pme-finance",
  "version": "1.0.0",
  "private": true,
  "description": "Plateforme intégrée de gestion commerciale et financière des PME avec détection intelligente des anomalies et supervision à distance",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace=apps/api run start:dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "dev:desktop": "python apps/desktop-py/main.py",
    "desktop:py": "python apps/desktop-py/main.py",
    "build:shared": "npm --workspace=packages/shared run build",
    "build:api": "npm --workspace=apps/api run build",
    "build:web": "npm --workspace=apps/web run build",
    "build:desktop:exe": "python scripts/build_exe.py",
    "backup:db": "scripts\\backup_db.bat",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate deploy",
    "prisma:migrate:dev": "npx prisma migrate dev",
    "prisma:push": "npx prisma db push",
    "prisma:seed": "npx ts-node prisma/seed.ts",
    "prisma:studio": "npx prisma studio",
    "test": "npm --workspace=apps/api run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prisma": "^6.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1"
  }
}
